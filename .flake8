[flake8]
select = B,B9,C,D,DAR,E,F,N,RST,S,W
ignore = E203,E501,RST201,RST203,RST301,W503,C901,S404,RST307,RST219,RST303,S108,RST305,RST205,S603,S602
max-line-length = 105
max-complexity = 10
docstring-convention = google
per-file-ignores =
    tests/*:S101,
    src/scannls/__init__.py:F401,
    src/scannls/draft/nls_inference.py:F841,
rst-roles = class,const,func,meth,mod,ref
rst-directives = deprecated,seealso,note
exclude =
    src/scannls/call/*,
    src/scannls/isoform/*,
    noxfile.py,
